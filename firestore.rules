rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function validEmail() {
   return request.auth != null
     && request.auth.token.email_verified == true
     && request.auth.token.email is string
     && request.auth.token.email == request.auth.token.email.lower();
  }
  function isAllowed() {
   return validEmail()
     && exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email))
     && get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.enabled == true;
  }
  match /allowedEmails/{email} {
   allow get: if validEmail() && request.auth.token.email == email;
   allow list, create, update, delete: if false;
  }
  match /users/{userId}/app/{documentId} {
   allow read, write: if isAllowed() && request.auth.uid == userId && documentId == 'main';
  }
  match /users/{userId}/v2/{documentId} {
   allow read, write: if isAllowed() && request.auth.uid == userId && documentId == 'config';
  }
  match /users/{userId}/days/{dateId} {
   allow read, write: if isAllowed() && request.auth.uid == userId && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
  }
  match /{document=**} {allow read, write: if false;}
 }
}

